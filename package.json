{
  "name": "minecraft_in_browser",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:all": "node scripts/test.mjs --all",
    "test:list": "node scripts/test.mjs --list",
    "test:mob": "node scripts/test.mjs mob",
    "test:agent": "node scripts/test.mjs agent",
    "test:bot": "node --test --test-isolation=none tests/playerBot.test.js tests/playerBotSurvival.test.js tests/playerBotSurvivalScenarios.test.js tests/playerBotCapabilities.test.js",
    "test:tutorials": "node --test --test-isolation=none tests/tutorials/tier*.test.js",
    "test:survival:bot": "playwright test -c playwright.survival.config.js",
    "test:smith:bot": "playwright test -c playwright.smith.config.js",
    "test:water:browser": "playwright test -c playwright.water.config.js",
    "test:share:browser": "playwright test -c playwright.share.config.js",
    "share": "vite build && node server/shareServer.js",
    "share:check": "node scripts/check-share.mjs",
    "test:world:browser": "playwright test -c playwright.worldStart.config.js",
    "profile:water": "node scripts/profile-water.mjs",
    "test:bot:browser": "playwright test -c playwright.bot.config.js",
    "test:redstone": "node scripts/test.mjs redstone",
    "test:studio": "node scripts/test.mjs studio",
    "test:world": "node scripts/test.mjs world",
    "test:build": "node scripts/test.mjs build",
    "test:combat": "node scripts/test.mjs combat",
    "test:render": "node scripts/test.mjs render",
    "test:persist": "node scripts/test.mjs persist",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:cloudflare:share": "npx wrangler deploy --config cloudflare/share/wrangler.jsonc",
    "deploy:cloudflare": "npm run deploy:cloudflare:share && npm run build && npx wrangler pages deploy dist --project-name blockyland",
    "mods:generate": "node scripts/generate-mod-catalog.mjs",
    "predev": "npm run mods:generate",
    "prebuild": "npm run mods:generate",
    "test:mods": "node --test --test-isolation=none tests/modStructure.test.js tests/modInspectorIsolation.test.js tests/rescueAdventure.test.js tests/modAuthority.test.js tests/savedMapLoadProgress.test.js tests/campaignPresentation.test.js",
    "test:mods:visuals": "node scripts/test-campaign-visuals.mjs",
    "benchmark:textures:cpu": "node scripts/benchmark-textures-cpu.mjs",
    "test:agent:vault": "node --test --test-isolation=none tests/agentKeyVault.test.js",
    "test:agent:vault:browser": "node scripts/test-agent-key-vault.mjs"
  },
  "type": "module",
  "dependencies": {
    "three": "^0.186.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "vite": "^8.3.1"
  },
  "overrides": {
    "axios": "0.34.0",
    "uuid": "11.1.1"
  }
}
